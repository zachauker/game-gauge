# Application
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL="postgresql://gamegauge:gamegauge_dev_password@localhost:5555/gamegauge?schema=public"

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Redis Cache (optional for MVP)
REDIS_URL=redis://localhost:6379

# CORS
CORS_ORIGIN=http://localhost:5173

# External API Keys (for game metadata)
# Get these from https://api.igdb.com/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Logging
LOG_LEVEL=debug

### Game Gauge API - HTTP Requests
### Use these to test your API endpoints directly in WebStorm
### Click the ▶ icon next to each request to run it

### Variables
@host = http://localhost:3000
@contentType = application/json

###############################################
# Health Check
###############################################

### Check API health
GET {{host}}/health

###############################################
# Authentication
###############################################

### Register new user
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "john.doe@example.com",
  "username": "johndoe",
  "password": "SecurePass123",
  "firstName": "John",
  "lastName": "Doe"
}

### Register another test user
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "jane.smith@example.com",
  "username": "janesmith",
  "password": "SecurePass123",
  "firstName": "Jane",
  "lastName": "Smith"
}

### Login user (saves token to environment)
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "john.doe@example.com",
  "password": "SecurePass123"
}

> {%
    // Save token to environment variable for subsequent requests
    if (response.body.success && response.body.data.token) {
        client.global.set("auth_token", response.body.data.token);
        console.log("Token saved:", response.body.data.token);
    }
%}

### Login with invalid credentials (should fail)
POST {{host}}/api/auth/login
Content-Type: {{contentType}}

{
  "email": "john.doe@example.com",
  "password": "WrongPassword"
}

### Get current user (requires authentication)
GET {{host}}/api/auth/me
Authorization: Bearer {{auth_token}}

### Get current user without token (should fail)
GET {{host}}/api/auth/me

###############################################
# Validation Tests
###############################################

### Register with invalid email
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "not-an-email",
  "username": "testuser",
  "password": "Test1234"
}

### Register with short password
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "test@example.com",
  "username": "testuser",
  "password": "short"
}

### Register with weak password (no uppercase)
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "test@example.com",
  "username": "testuser",
  "password": "weakpassword123"
}

### Register with invalid username (special chars)
POST {{host}}/api/auth/register
Content-Type: {{contentType}}

{
  "email": "test@example.com",
  "username": "test@user!",
  "password": "Test1234"
}

###############################################
# Games
###############################################

### Get all games (public)
GET {{host}}/api/games

### Get games with pagination
GET {{host}}/api/games?page=1&limit=10

### Search games by title
GET {{host}}/api/games?search=zelda

### Filter by genre
GET {{host}}/api/games?genre=RPG

### Filter by platform
GET {{host}}/api/games?platform=Nintendo Switch

### Advanced filtering with sorting
GET {{host}}/api/games?search=mario&genre=Platformer&sortBy=releaseDate&sortOrder=desc&limit=5

### Get top-rated games
GET {{host}}/api/games/top-rated?limit=10

### Get recently added games
GET {{host}}/api/games/recent?limit=10

### Create game (requires authentication)
POST {{host}}/api/games
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "title": "The Legend of Zelda: Breath of the Wild",
  "description": "An open-world action-adventure game set in the kingdom of Hyrule. Players take on the role of Link as he awakens from a 100-year slumber to defeat Calamity Ganon and save Princess Zelda.",
  "releaseDate": "2017-03-03",
  "developer": "Nintendo EPD",
  "publisher": "Nintendo",
  "genres": ["Action", "Adventure", "Open World"],
  "platforms": ["Nintendo Switch", "Wii U"],
  "metacritic": 97
}

> {%
    // Save game ID for subsequent requests
    if (response.body.success && response.body.data.id) {
        client.global.set("game_id", response.body.data.id);
        client.global.set("game_slug", response.body.data.slug);
        console.log("Game created:", response.body.data.title);
        console.log("Game ID:", response.body.data.id);
        console.log("Game slug:", response.body.data.slug);
    }
%}

### Create another game
POST {{host}}/api/games
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "title": "Elden Ring",
  "description": "An action RPG set in the Lands Between, featuring intense combat and a vast open world to explore.",
  "releaseDate": "2022-02-25",
  "developer": "FromSoftware",
  "publisher": "Bandai Namco",
  "genres": ["Action RPG", "Dark Fantasy", "Open World"],
  "platforms": ["PlayStation 5", "PlayStation 4", "Xbox Series X/S", "Xbox One", "PC"],
  "metacritic": 96
}

### Create game without optional fields
POST {{host}}/api/games
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "title": "Super Mario Bros.",
  "genres": ["Platformer"],
  "platforms": ["NES"]
}

### Get game by ID
GET {{host}}/api/games/{{game_id}}

### Get game by slug (SEO-friendly)
GET {{host}}/api/games/slug/{{game_slug}}

### Update game (requires authentication)
PATCH {{host}}/api/games/{{game_id}}
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "description": "Updated description with more details about the game.",
  "metacritic": 98
}

### Update game title (will regenerate slug)
PATCH {{host}}/api/games/{{game_id}}
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "title": "The Legend of Zelda: Breath of the Wild - Updated"
}

### Delete game (requires authentication)
DELETE {{host}}/api/games/{{game_id}}
Authorization: Bearer {{auth_token}}

###############################################
# Reviews
###############################################

### Create a review for a game
POST {{host}}/api/games/{{game_id}}/reviews
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "This is an absolutely amazing game! The open world is breathtaking, the gameplay is innovative, and the story is captivating. Easily one of the best games I've ever played. Highly recommended for anyone who loves adventure games."
}

> {%
    // Save review ID for subsequent requests
    if (response.body.success && response.body.data.id) {
        client.global.set("review_id", response.body.data.id);
        console.log("Review created:", response.body.data.id);
    }
%}

### Create another review with different content
POST {{host}}/api/games/{{game_id}}/reviews
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "Great game with beautiful graphics and engaging gameplay. The combat system is well-designed and the world is full of interesting things to discover."
}

### Get current user's review for a game
GET {{host}}/api/games/{{game_id}}/reviews/me
Authorization: Bearer {{auth_token}}

### Check if user has reviewed a game
GET {{host}}/api/games/{{game_id}}/reviews/check
Authorization: Bearer {{auth_token}}

### Get all reviews for a game (public)
GET {{host}}/api/games/{{game_id}}/reviews

### Get reviews with pagination and sorting
GET {{host}}/api/games/{{game_id}}/reviews?page=1&limit=10&sortBy=createdAt&sortOrder=desc

### Get a single review by ID
GET {{host}}/api/reviews/{{review_id}}

### Get all reviews by current user
GET {{host}}/api/reviews/me
Authorization: Bearer {{auth_token}}

### Get recent reviews by current user
GET {{host}}/api/reviews/me/recent?limit=5
Authorization: Bearer {{auth_token}}

### Get recent reviews across platform (public)
GET {{host}}/api/reviews/recent?limit=10

### Update a review (user's own only)
PATCH {{host}}/api/reviews/{{review_id}}
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "Updated review: After playing more, I have to say this game gets even better. The late-game content is incredible and there's so much replay value. Definitely a masterpiece!"
}

### Delete a review (user's own only)
DELETE {{host}}/api/reviews/{{review_id}}
Authorization: Bearer {{auth_token}}

### Try creating review with too short content (should fail)
POST {{host}}/api/games/{{game_id}}/reviews
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "Too short"
}

### Try creating review with too long content (should fail)
POST {{host}}/api/games/{{game_id}}/reviews
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "Lorem ipsum dolor sit amet, consectetur adipiscing elit... (imagine 5001 characters here)"
}

### Try creating duplicate review (should fail)
POST {{host}}/api/games/{{game_id}}/reviews
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "This should fail because I already reviewed this game."
}

### Try updating someone else's review (should fail)
PATCH {{host}}/api/reviews/00000000-0000-0000-0000-000000000000
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "content": "Trying to edit someone else's review"
}

### Try creating review without authentication (should fail)
POST {{host}}/api/games/{{game_id}}/reviews
Content-Type: {{contentType}}

{
  "content": "This should fail because I'm not authenticated."
}

###############################################
# Ratings
###############################################

### Rate a game (create or update rating)
POST {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "score": 9
}

### Rate another game with different score
POST {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "score": 7
}

### Update existing rating (same user, same game)
POST {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "score": 10
}

### Get current user's rating for a game
GET {{host}}/api/games/{{game_id}}/rating/me
Authorization: Bearer {{auth_token}}

### Check if user has rated a game
GET {{host}}/api/games/{{game_id}}/rating/check
Authorization: Bearer {{auth_token}}

### Get all ratings for a game (public)
GET {{host}}/api/games/{{game_id}}/ratings

### Get ratings with pagination
GET {{host}}/api/games/{{game_id}}/ratings?page=1&limit=10

### Get rating statistics for a game (public)
GET {{host}}/api/games/{{game_id}}/rating/stats

### Get all ratings by current user
GET {{host}}/api/ratings/me
Authorization: Bearer {{auth_token}}

### Get recent ratings by current user
GET {{host}}/api/ratings/me/recent?limit=5
Authorization: Bearer {{auth_token}}

### Delete user's rating
DELETE {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}

### Try rating with invalid score (should fail)
POST {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "score": 11
}

### Try rating with score of 0 (should fail)
POST {{host}}/api/games/{{game_id}}/rating
Authorization: Bearer {{auth_token}}
Content-Type: {{contentType}}

{
  "score": 0
}

### Try rating without authentication (should fail)
POST {{host}}/api/games/{{game_id}}/rating
Content-Type: {{contentType}}

{
  "score": 8
}


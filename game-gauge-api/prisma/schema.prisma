// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String  @id @default(uuid())
  email     String? @unique
  username  String  @unique
  password  String?
  firstName String?
  lastName  String?
  bio       String?
  avatar    String?

  // Steam integration
  steamId         String? @unique
  steamUsername   String?
  steamAvatar     String?
  steamProfileUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews      Review[]
  lists        GameList[]
  ratings      Rating[]
  helpfulVotes ReviewHelpful[]
  steamLibrary SteamLibrarySync[]

  // Social
  followers  UserFollow[]    @relation("Following")
  following  UserFollow[]    @relation("Follower")
  activities ActivityEvent[]

  @@index([email])
  @@index([username])
  @@index([steamId])
}

model Game {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  releaseDate DateTime?
  developer   String?
  publisher   String?
  genres      String[]
  platforms   String[]
  coverImage  String?

  // External API metadata
  igdbId     Int? @unique
  metacritic Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews             Review[]
  ratings             Rating[]
  listItems           GameListItem[]
  steamLibraryEntries SteamLibrarySync[]
  steamAppMappings    SteamAppMapping[]
  activityEvents      ActivityEvent[]

  @@index([slug])
  @@index([title])
  @@index([igdbId])
}

model Review {
  id           String   @id @default(uuid())
  content      String   @db.Text
  userId       String
  gameId       String
  ratingId     String?  @unique
  spoilers     Boolean  @default(false)
  helpfulCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  game         Game            @relation(fields: [gameId], references: [id], onDelete: Cascade)
  rating       Rating?         @relation(fields: [ratingId], references: [id], onDelete: SetNull)
  helpfulVotes ReviewHelpful[]

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId])
  @@index([createdAt])
  @@index([helpfulCount])
}

model ReviewHelpful {
  id        String   @id @default(uuid())
  userId    String
  reviewId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  review Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@unique([userId, reviewId])
  @@index([reviewId])
  @@index([userId])
}

model Rating {
  id        String   @id @default(uuid())
  score     Int // 1-10 scale
  userId    String
  gameId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  game   Game    @relation(fields: [gameId], references: [id], onDelete: Cascade)
  review Review?

  @@unique([userId, gameId])
  @@index([gameId])
  @@index([userId])
}

model GameList {
  id          String  @id @default(uuid())
  name        String
  description String?
  isPublic    Boolean @default(false)
  listType    String  @default("custom")
  isDefault   Boolean @default(false)

  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items GameListItem[]

  @@index([userId])
  @@index([isPublic])
  @@index([listType])
  @@index([userId, listType])
}

model GameListItem {
  id        String   @id @default(uuid())
  listId    String
  gameId    String
  order     Int      @default(0)
  notes     String?
  createdAt DateTime @default(now())

  progressPct  Int?
  progressNote String?

  completedAt    DateTime?
  completionType String?

  steamAchievements Json?

  list GameList @relation(fields: [listId], references: [id], onDelete: Cascade)
  game Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([listId, gameId])
  @@index([listId])
  @@index([order])
  @@index([completedAt])
  @@index([completionType])
}

// ──────────────────────────────────────────────────────
// Global Steam AppID → IGDB / Game Gauge mapping cache
// ──────────────────────────────────────────────────────
model SteamAppMapping {
  id          String   @id @default(uuid())
  steamAppId  Int      @unique
  igdbId      Int?
  gameId      String?
  gameName    String
  matched     Boolean  @default(false)
  lastChecked DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([igdbId])
}

// ──────────────────────────────────────────────────────
// Per-user Steam library cache
// ──────────────────────────────────────────────────────
model SteamLibrarySync {
  id              String    @id @default(uuid())
  userId          String
  steamAppId      Int
  gameId          String?
  name            String
  playtimeForever Int       @default(0)
  playtimeRecent  Int       @default(0)
  iconUrl         String?
  lastPlayed      DateTime?
  lastSynced      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@unique([userId, steamAppId])
  @@index([userId])
  @@index([gameId])
  @@index([playtimeForever])
  @@index([playtimeRecent])
}

// ──────────────────────────────────────────────────────
// Social — Follow graph
// ──────────────────────────────────────────────────────
model UserFollow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ──────────────────────────────────────────────────────
// Social — Activity event log (powers feed)
// ──────────────────────────────────────────────────────
model ActivityEvent {
  id        String   @id @default(uuid())
  userId    String
  type      String // RATED_GAME | REVIEWED_GAME | ADDED_TO_LIST | COMPLETED_GAME | STARTED_GAME | FOLLOWED_USER | CREATED_LIST
  gameId    String?
  targetId  String? // reviewId | listId | followingId — depends on type
  meta      Json? // snapshot: game title, cover, score, review excerpt, etc.
  createdAt DateTime @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game? @relation(fields: [gameId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([gameId])
}
